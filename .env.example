# =============================================================================
# Stashly — Environment Variables Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application URL
# -----------------------------------------------------------------------------
# Local development: http://localhost:3000
# Production: https://stashly.ihornone.site (or your custom domain)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 2. Clerk Authentication (Required)
# -----------------------------------------------------------------------------
# Create an application at https://dashboard.clerk.com
# Obtain these keys from Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk internal routing paths (Leave as default)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# -----------------------------------------------------------------------------
# 3. Telegram Bot Integration (Optional)
# -----------------------------------------------------------------------------
# 1. Create a bot using @BotFather on Telegram (https://t.me/BotFather)
# 2. Copy the HTTP API token provided by BotFather
# 3. Specify the bot's username without the '@' symbol
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# (Optional) Secret token for verifying webhook requests from Telegram API
TELEGRAM_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# 4. Storage & Cloudflare Configuration (Production / Workers)
# -----------------------------------------------------------------------------
# For local development, Stashly uses SQLite automatically (./storage/database.sqlite).
# For Cloudflare deployment, configure bindings in wrangler.toml (D1 database and KV).
